<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#172B4D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:lineSpacingExtra="8dp"
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Attached receipt"
            android:textColor="#172B4D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/receiptImage"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:contentDescription="Attached purchase receipt"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/edit"
            style="@style/WarrantyButton"
            android:layout_marginTop="24dp"
            android:text="Edit product" />

        <Button
            android:id="@+id/delete"
            style="@style/WarrantyButton"
            android:layout_marginTop="8dp"
            android:backgroundTint="#DC2626"
            android:text="Delete product" />

    </LinearLayout>
</ScrollView>